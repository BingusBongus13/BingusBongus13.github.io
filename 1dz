<h2 id="form-section">Форма</h2>
<form action="/submit" method="post">
  <label for="fullname">ФИО:</label><br>
  <input type="text" id="fullname" name="fullname" required><br><br>
  <label for="phone">Телефон:</label><br>
  <input type="tel" id="phone" name="phone" placeholder="+7 (___) ___-__-__"><br><br>
  <label for="email">E-mail:</label><br>
  <input type="email" id="email" name="email" required><br><br>
  <label for="birthdate">Дата рождения:</label><br>
  <input type="date" id="birthdate" name="birthdate"><br><br>
  <label>Пол:</label><br>
  <input type="radio" id="male" name="gender" value="male">
  <label for="male">Мужской</label>
  <input type="radio" id="female" name="gender" value="female">
  <label for="female">Женский</label><br><br>
  <label for="languages">Любимый язык программирования (можно выбрать несколько):</label><br>
  <select id="languages" name="languages" multiple size="8">
    <option value="pascal">Pascal</option>
    <option value="c">C</option>
    <option value="cpp">C++</option>
    <option value="javascript">JavaScript</option>
    <option value="php">PHP</option>
    <option value="python">Python</option>
    <option value="java">Java</option>
    <option value="haskell">Haskell</option>
    <option value="clojure">Clojure</option>
    <option value="prolog">Prolog</option>
    <option value="scala">Scala</option>
  </select><br><br>
  <label for="bio">Биография:</label><br>
  <textarea id="bio" name="bio" rows="5" cols="40"></textarea><br><br>
  <input type="checkbox" id="contract" name="contract" value="yes">
  <label for="contract">С контрактом ознакомлен(а)</label><br><br>
  <button type="submit">Сохранить</button>
</form>

